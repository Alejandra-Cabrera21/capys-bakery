@model Producto
@{
    ViewData["Title"] = Model.Nombre;

    // Opciones de personalización habilitadas para ESTE producto (ver
    // AdminProductos/Formulario "Personalizaciones disponibles"),
    // agrupadas por tipo (Decoración, Topping, ...). Antes esto eran
    // botones de color/topping fijos en el HTML, sin precio ni conexión a
    // la base de datos, y solo aparecían si la categoría era "Pastel".
    // Ahora salen solo si el admin de verdad las asignó a este producto.
    var gruposPersonalizacion = Model.OpcionesPersonalizacion
        .Where(o => o.Disponible && o.Opcion is not null)
        .OrderBy(o => o.Opcion!.TipoPersonalizacionId)
        .GroupBy(o => o.Opcion!.TipoPersonalizacion?.Nombre ?? "Personalización")
        .ToList();
}

<div style="max-width:1400px; margin:0 auto; padding:24px 56px 0 56px;">
    <a asp-controller="Catalogo" asp-action="Index" style="color:var(--ink-soft); font-size:13.5px; text-decoration:none;">
        ← Volver al menú
    </a>
</div>

<div class="cb-pd-layout">
    <div class="cb-pd-gallery">
        @if (Model.Imagenes.Any())
        {
            var imagenes = Model.Imagenes.OrderByDescending(i => i.EsPrincipal).ThenBy(i => i.Orden).ToList();
            <div class="cb-pd-carousel" data-carousel>
                <div class="cb-pd-carousel-track">
                    @foreach (var img in imagenes)
                    {
                        <div class="cb-pd-carousel-slide">
                            <img src="@img.UrlImagen" alt="@Model.Nombre" />
                        </div>
                    }
                </div>
                @if (imagenes.Count > 1)
                {
                    <button type="button" class="cb-pd-carousel-arrow cb-pd-carousel-prev" aria-label="Imagen anterior">‹</button>
                    <button type="button" class="cb-pd-carousel-arrow cb-pd-carousel-next" aria-label="Siguiente imagen">›</button>
                    <div class="cb-pd-carousel-dots">
                        @for (int i = 0; i < imagenes.Count; i++)
                        {
                            <button type="button" class="cb-pd-carousel-dot @(i == 0 ? "active" : "")" data-index="@i" aria-label="Imagen @(i + 1)"></button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="cb-pd-main-img"><svg width="90" height="90" viewBox="0 0 24 24" fill="none" stroke="#7C2B3B" stroke-width="1"><ellipse cx="12" cy="9" rx="7" ry="5"/><path d="M5 9v6a7 3 0 0 0 14 0V9"/></svg></div>
        }
    </div>
    <div class="cb-pd-info">
        <div class="cb-product-tag">@Model.CategoriaPrincipal</div>
        <h1>@Model.Nombre</h1>
        <div class="cb-pd-price" id="cb-pd-precio-mostrado">Q@(Model.Presentaciones.First().Precio.ToString("0.00"))</div>
        <p class="cb-pd-desc">@Model.Descripcion</p>

        <form id="form-agregar-carrito" data-producto-id="@Model.Id" data-producto-nombre="@Model.Nombre" data-producto-imagen="@Model.ImagenUrl">
            @if (Model.Presentaciones.Count > 1)
            {
                <div class="cb-config-block">
                    <h4>Tamaño / presentación</h4>
                    <div class="cb-size-options" data-config="tamano">
                        @for (int i = 0; i < Model.Presentaciones.Count; i++)
                        {
                            var p = Model.Presentaciones[i];
                            <button type="button" class="cb-size-option @(i == 0 ? "active" : "")"
                                    data-valor="@p.Nombre" data-precio="@p.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-presentacion-id="@p.Id">
                                <span class="cb-size-name">@p.Nombre</span>
                                <span class="cb-size-porciones">@p.Porciones porcion@(p.Porciones == 1 ? "" : "es")</span>
                                <span class="cb-size-precio">Q@(p.Precio.ToString("0.00"))</span>
                            </button>
                        }
                    </div>
                </div>
            }
            else if (Model.Presentaciones.Count == 1)
            {
                var unica = Model.Presentaciones[0];
                <div class="cb-size-options" data-config="tamano" hidden>
                    <button type="button" class="cb-size-option active" data-valor="@unica.Nombre"
                            data-precio="@unica.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-presentacion-id="@unica.Id"></button>
                </div>
            }

            @for (int g = 0; g < gruposPersonalizacion.Count; g++)
            {
                var grupo = gruposPersonalizacion[g];
                var esSeleccionUnica = grupo.Key == "Decoración";
                <div class="cb-config-block">
                    <h4>@grupo.Key</h4>
                    <div class="cb-chip-row" data-config="personalizacion-@g" data-multiple="@(esSeleccionUnica ? "false" : "true")">
                        @{ var primero = true; }
                        @foreach (var op in grupo)
                        {
                            <button type="button" class="cb-chip @(esSeleccionUnica && primero ? "active" : "")"
                                    data-valor="@op.Opcion!.Nombre" data-opcion-id="@op.Id"
                                    data-precio="@op.PrecioAdicional.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                @op.Opcion!.Nombre@(op.PrecioAdicional > 0 ? $" (+Q{op.PrecioAdicional:0.00})" : "")
                            </button>
                            primero = false;
                        }
                    </div>
                </div>
            }

            @if (Model.Alergenos.Any())
            {
                <div class="cb-config-block">
                    <h4>Alérgenos</h4>
                    <div class="cb-allergen-row">
                        @foreach (var alergeno in Model.Alergenos)
                        {
                            <span class="cb-allergen-chip">⚠ @alergeno.Nombre</span>
                        }
                    </div>
                </div>
            }

            <div class="cb-qty-row">
                <h4 style="margin:0;">Cantidad</h4>
                <div class="cb-qty-box">
                    <button type="button" class="cb-qty-minus">−</button>
                    <span class="cb-qty-value">1</span>
                    <button type="button" class="cb-qty-plus">+</button>
                </div>
            </div>

            <div class="cb-pd-btns">
                <button type="button" class="btn cb-btn-outline" id="btn-agregar-favoritos" data-producto-id="@Model.Id">♡ Agregar a favoritos</button>
                <button type="submit" class="btn cb-btn-plum" id="btn-agregar-carrito">Agregar al carrito</button>
            </div>
        </form>
    </div>
</div>

<style>
    .cb-pd-carousel {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 12px;
        background: #F2E4D0;
    }
    .cb-pd-carousel-track {
        display: flex;
        height: 100%;
        transition: transform 0.35s ease;
    }
    .cb-pd-carousel-slide {
        flex: 0 0 100%;
        height: 100%;
    }
    .cb-pd-carousel-slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .cb-pd-carousel-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.85);
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        font-size: 20px;
        line-height: 1;
        cursor: pointer;
        color: #7C2B3B;
    }
    .cb-pd-carousel-prev { left: 12px; }
    .cb-pd-carousel-next { right: 12px; }
    .cb-pd-carousel-dots {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 6px;
    }
    .cb-pd-carousel-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: none;
        background: rgba(255,255,255,0.6);
        cursor: pointer;
        padding: 0;
    }
    .cb-pd-carousel-dot.active {
        background: #7C2B3B;
    }
</style>

@section Scripts {
    <script src="~/js/configurador.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const carousel = document.querySelector("[data-carousel]");
            if (!carousel) return;

            const track = carousel.querySelector(".cb-pd-carousel-track");
            const slides = carousel.querySelectorAll(".cb-pd-carousel-slide");
            const dots = carousel.querySelectorAll(".cb-pd-carousel-dot");
            const prevBtn = carousel.querySelector(".cb-pd-carousel-prev");
            const nextBtn = carousel.querySelector(".cb-pd-carousel-next");
            let indice = 0;

            function irA(nuevoIndice) {
                indice = (nuevoIndice + slides.length) % slides.length;
                track.style.transform = `translateX(-${indice * 100}%)`;
                dots.forEach((dot, i) => dot.classList.toggle("active", i === indice));
            }

            prevBtn?.addEventListener("click", () => irA(indice - 1));
            nextBtn?.addEventListener("click", () => irA(indice + 1));
            dots.forEach((dot) => dot.addEventListener("click", () => irA(parseInt(dot.dataset.index, 10))));
        });
    </script>
}

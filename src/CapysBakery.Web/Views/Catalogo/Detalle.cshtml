@model Producto
@{
    ViewData["Title"] = Model.Nombre;
}

<div class="cb-pd-layout">
    <div class="cb-pd-gallery">
        <div class="cb-pd-main-img"><svg width="90" height="90" viewBox="0 0 24 24" fill="none" stroke="#7C2B3B" stroke-width="1"><ellipse cx="12" cy="9" rx="7" ry="5"/><path d="M5 9v6a7 3 0 0 0 14 0V9"/></svg></div>
    </div>
    <div class="cb-pd-info">
        <div class="cb-product-tag">@Model.CategoriaPrincipal personalizado</div>
        <h1>@Model.Nombre</h1>
        <div class="cb-pd-price" id="cb-pd-precio-mostrado">Q@(Model.Presentaciones.First().Precio.ToString("0.00"))</div>
        <p class="cb-pd-desc">@Model.Descripcion</p>

        <form id="form-agregar-carrito" data-producto-id="@Model.Id" data-producto-nombre="@Model.Nombre">
            <div class="cb-config-block">
                <h4>Tamaño / presentación</h4>
                <div class="cb-size-options" data-config="tamano">
                    @for (int i = 0; i < Model.Presentaciones.Count; i++)
                    {
                        var p = Model.Presentaciones[i];
                        <button type="button" class="cb-size-option @(i == 0 ? "active" : "")"
                                data-valor="@p.Nombre" data-precio="@p.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-presentacion-id="@p.Id">
                            <span class="cb-size-name">@p.Nombre</span>
                            <span class="cb-size-porciones">@p.Porciones porcion@(p.Porciones == 1 ? "" : "es")</span>
                            <span class="cb-size-precio">Q@(p.Precio.ToString("0.00"))</span>
                        </button>
                    }
                </div>
            </div>

            @if (Model.CategoriaPrincipal == "Pastel" || Model.CategoriaPrincipal == "Pasteles")
            {
                <div class="cb-config-block">
                    <h4>Color de decoración</h4>
                    <div class="cb-swatch-row" data-config="color">
                        <button type="button" class="cb-swatch active" data-valor="Ciruela" style="background:#7C2B3B;"></button>
                        <button type="button" class="cb-swatch" data-valor="Dorado" style="background:#C9982E;"></button>
                        <button type="button" class="cb-swatch" data-valor="Blush" style="background:#F2D6C9;"></button>
                        <button type="button" class="cb-swatch" data-valor="Chocolate" style="background:#3A2419;"></button>
                    </div>
                </div>

                <div class="cb-config-block">
                    <h4>Toppings y flores comestibles</h4>
                    <div class="cb-chip-row" data-config="toppings" data-multiple="true">
                        <button type="button" class="cb-chip active" data-valor="Flores comestibles">Flores comestibles</button>
                        <button type="button" class="cb-chip" data-valor="Chocolate rallado">Chocolate rallado</button>
                        <button type="button" class="cb-chip" data-valor="Frutos rojos">Frutos rojos</button>
                        <button type="button" class="cb-chip" data-valor="Hojas de menta">Hojas de menta</button>
                    </div>
                </div>
            }

            @if (Model.Alergenos.Any())
            {
                <div class="cb-config-block">
                    <h4>Alérgenos</h4>
                    <div class="cb-allergen-row">
                        @foreach (var alergeno in Model.Alergenos)
                        {
                            <span class="cb-allergen-chip">⚠ @alergeno.Nombre</span>
                        }
                    </div>
                </div>
            }

            <div class="cb-qty-row">
                <h4 style="margin:0;">Cantidad</h4>
                <div class="cb-qty-box">
                    <button type="button" class="cb-qty-minus">−</button>
                    <span class="cb-qty-value">1</span>
                    <button type="button" class="cb-qty-plus">+</button>
                </div>
            </div>

            <div class="cb-pd-btns">
                <button type="button" class="btn cb-btn-outline" id="btn-agregar-favoritos" data-producto-id="@Model.Id">♡ Agregar a favoritos</button>
                <button type="submit" class="btn cb-btn-plum" id="btn-agregar-carrito">Agregar al carrito</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/configurador.js" asp-append-version="true"></script>
}

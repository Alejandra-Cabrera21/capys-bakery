@{
    ViewData["Title"] = "Blog";
}

<div class="cb-catalog-hero">
    <span class="eyebrow">recetas, tips y detrás de cámaras</span>
    <h1>El diario de Capys</h1>
    <p>Nuestro proceso, recetas para intentar en casa y todo lo que aprendemos horneando cada semana.</p>
</div>

<div class="cb-section" style="padding-top:10px;">
    <div class="cb-blog-featured">
        <div class="cb-blog-featured-img"></div>
        <div class="cb-blog-featured-copy">
            <div class="cb-blog-date">Destacado · 3 de agosto</div>
            <h2 style="font-size:26px; margin-bottom:12px;">Cómo hacemos nuestro merengue perfecto para el pie de limón</h2>
            <p style="font-size:13.5px; color:var(--ink-soft); line-height:1.7; margin-bottom:18px;">Después de docenas de intentos fallidos, así es como logramos un merengue firme, brillante y sin que se baje.</p>
            <a class="btn cb-btn-outline" style="display:inline-block; width:fit-content;">Leer receta completa</a>
        </div>
    </div>

    <div class="cb-blog-cat-row">
        <div class="cb-blog-cat active">Todos</div>
        <div class="cb-blog-cat">Recetas</div>
        <div class="cb-blog-cat">Detrás de cámaras</div>
        <div class="cb-blog-cat">Tips</div>
    </div>

    <div class="cb-blog-grid">
        <div class="cb-blog-card">
            <div class="cb-blog-card-img" style="background:linear-gradient(135deg,#E8C99B,#C9982E);"></div>
            <div class="cb-blog-card-body"><div class="cb-blog-date">Recetas · 28 jul</div><h4>3 formas de decorar con flores comestibles</h4><p>Guía rápida para principiantes.</p></div>
        </div>
        <div class="cb-blog-card">
            <div class="cb-blog-card-img" style="background:linear-gradient(135deg,#F2D6C9,#D96E5C);"></div>
            <div class="cb-blog-card-body"><div class="cb-blog-date">Detrás de cámaras · 20 jul</div><h4>Un día en la cocina de Capys</h4><p>Una jornada completa de horneado.</p></div>
        </div>
        <div class="cb-blog-card">
            <div class="cb-blog-card-img" style="background:linear-gradient(135deg,#D9B48F,#A87A1E);"></div>
            <div class="cb-blog-card-body"><div class="cb-blog-date">Tips · 12 jul</div><h4>Cómo conservar tu pastel fresco por más días</h4><p>Errores comunes al guardar postres.</p></div>
        </div>
    </div>
</div>

<div class="cb-newsletter">
    <div>
        <h3>Recetas nuevas cada semana</h3>
        <p>Súmate y recibe nuestras publicaciones directo a tu correo.</p>
    </div>
    <form class="cb-newsletter-form" method="post" action="#">
        <input type="email" name="correo" placeholder="Tu correo electrónico" required />
        <button type="submit" class="btn cb-btn-plum">Suscribirme</button>
    </form>
</div>

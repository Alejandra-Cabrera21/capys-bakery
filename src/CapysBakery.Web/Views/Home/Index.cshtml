@model List<Producto>
@{
    ViewData["Title"] = "Inicio";
}

<section class="cb-hero">
    <div class="cb-hero-copy">
        <span class="eyebrow">— hecho con cariño, horneado con calma —</span>
        <h1>Dulces momentos,<br />hechos a mano.</h1>
        <p>Tartaletas, pies y pasteles artesanales horneados en pequeños lotes, con ingredientes reales y mucho tiempo de cariño. Cada pedido es único, como cada celebración.</p>
        <div class="cb-hero-btns">
            <a asp-controller="Catalogo" asp-action="Index" class="btn cb-btn-plum">Ver el menú</a>
            <a asp-controller="Nosotros" asp-action="Index" class="btn cb-btn-outline">Nuestra historia</a>
        </div>
        <div class="cb-hero-stats">
            <div><div class="n">500+</div><div class="l">Pedidos entregados</div></div>
            <div><div class="n">4.9★</div><div class="l">Calificación de clientes</div></div>
            <div><div class="n">100%</div><div class="l">Ingredientes reales</div></div>
        </div>
    </div>
    <div class="cb-hero-visual">
        <div class="cb-hero-img">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1"><ellipse cx="12" cy="16" rx="9" ry="3"/><path d="M3 16V9a9 3 0 0 1 18 0v7"/><path d="M7 9c0-2 1-4 5-4s5 2 5 4"/></svg>
        </div>
        <div class="cb-seal">hecho a<br />mano ✦<br />Capys</div>
    </div>
</section>

<div class="cb-scallop"></div>

<section class="cb-section">
    <div class="cb-section-head">
        <span class="eyebrow">nuestros favoritos</span>
        <h2>Lo más pedido esta semana</h2>
        <p>Una probadita de lo que sale de nuestro horno todos los días.</p>
    </div>

    <div class="cb-grid-4">
        @foreach (var producto in Model)
        {
            <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@producto.Id" class="cb-product-card">
                <div class="cb-product-img" style="background:linear-gradient(135deg,#F2D6C9,#E8B876);"></div>
                <div class="cb-product-body">
                    <div class="cb-product-tag">@producto.Categoria</div>
                    <div class="cb-product-name">@producto.Nombre</div>
                    <div class="cb-product-desc">@producto.Descripcion</div>
                    <div class="cb-product-foot">
                        <div class="cb-product-price">Desde Q@producto.Precio</div>
                        <span class="cb-add-btn">+</span>
                    </div>
                </div>
            </a>
        }
    </div>
</section>

@{
    var promociones = ViewBag.Promociones as List<Producto>;
}
@if (promociones is not null && promociones.Any())
{
    <section class="cb-section tinted" style="max-width:100%;">
        <div class="cb-section-inner" style="max-width:1400px; margin:0 auto;">
            <div class="cb-section-head">
                <span class="eyebrow">por tiempo limitado</span>
                <h2>Promociones y de temporada</h2>
            </div>
            <div class="cb-grid-4">
                @foreach (var promo in promociones)
                {
                    <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@promo.Id" class="cb-product-card">
                        <div class="cb-product-img" style="background:linear-gradient(135deg,#F0C9A0,#7C2B3B); position:relative;">
                            <span style="position:absolute; top:10px; left:10px; background:var(--plum); color:#fff; font-size:10px; font-weight:700; padding:4px 10px; border-radius:14px;">Promoción</span>
                        </div>
                        <div class="cb-product-body">
                            <div class="cb-product-tag">@promo.Categoria</div>
                            <div class="cb-product-name">@promo.Nombre</div>
                            <div class="cb-product-desc">@promo.Descripcion</div>
                            <div class="cb-product-foot">
                                <span class="cb-product-price">Desde Q@promo.Precio</span>
                                <span class="cb-add-btn">+</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<div class="cb-section tinted">
    <div class="cb-section-inner">
        <div class="cb-story">
            <div class="cb-story-img">
                <svg width="140" height="140" viewBox="0 0 24 24" fill="none" stroke="#7C2B3B" stroke-width="1"><path d="M4 12c2-6 14-6 16 0M4 12c1 5 4 8 8 8s7-3 8-8M4 12h16"/></svg>
            </div>
            <div class="cb-story-copy">
                <span class="eyebrow">nuestra historia</span>
                <h2>De la cocina de casa<br />a tu mesa</h2>
                <p>Capys Bakery nació entre pruebas, errores y hornadas de madrugada en una cocina pequeña, con la idea simple de compartir postres que supieran como los de casa. Hoy seguimos horneando lote por lote, sin atajos, para que cada bocado se sienta hecho especialmente para ti.</p>
                <a href="#" class="btn cb-btn-plum">Conoce más de nosotros</a>
            </div>
        </div>
    </div>
</div>

<section class="cb-section">
    <div class="cb-section-head">
        <span class="eyebrow">lo que dicen de nosotros</span>
        <h2>Momentos que endulzamos</h2>
    </div>
    <div class="cb-testi-row">
        <div class="cb-testi-card">
            <div class="cb-stars">★★★★★</div>
            <p>"El pastel de chocolate para el cumpleaños de mi hija fue el favorito de todos. Se nota que está hecho con calma y cariño."</p>
            <div class="cb-testi-who">
                <div class="cb-testi-avatar"></div>
                <div><div class="cb-testi-name">María José R.</div><div class="cb-testi-role">Cliente frecuente</div></div>
            </div>
        </div>
        <div class="cb-testi-card">
            <div class="cb-stars">★★★★★</div>
            <p>"Pedí el catering para mi boda y superó todas mis expectativas. Cada mesa preguntaba de dónde eran los postres."</p>
            <div class="cb-testi-who">
                <div class="cb-testi-avatar"></div>
                <div><div class="cb-testi-name">Andrés F.</div><div class="cb-testi-role">Evento privado</div></div>
            </div>
        </div>
        <div class="cb-testi-card">
            <div class="cb-stars">★★★★★</div>
            <p>"Las mermeladas son mi pedido fijo cada mes. Se nota la diferencia con las industriales, saben a fruta de verdad."</p>
            <div class="cb-testi-who">
                <div class="cb-testi-avatar"></div>
                <div><div class="cb-testi-name">Lucía M.</div><div class="cb-testi-role">Cliente frecuente</div></div>
            </div>
        </div>
    </div>
</section>

<div class="cb-newsletter">
    <div>
        <h3>No te pierdas ninguna hornada</h3>
        <p>Suscríbete y recibe primero los sabores de temporada y promociones especiales.</p>
    </div>
    <form class="cb-newsletter-form" method="post" action="#">
        <input type="email" name="correo" placeholder="Tu correo electrónico" required />
        <button type="submit" class="btn cb-btn-plum">Suscribirme</button>
    </form>
</div>

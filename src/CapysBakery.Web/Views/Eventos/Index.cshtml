@{
    ViewData["Title"] = "Eventos y Catering";
}

<div class="cb-catalog-hero" style="text-align:center;">
    <span class="eyebrow">celebraciones a tu medida</span>
    <h1>Eventos y Catering</h1>
    <p style="max-width:520px; margin:0 auto;">Desde cumpleaños íntimos hasta bodas y eventos corporativos — armamos el menú dulce perfecto para tu celebración.</p>
</div>

<div class="cb-section" style="padding-top:20px;">
    <div class="cb-pkg-row">
        <div class="cb-pkg-card">
            <h4>Cumpleaños</h4>
            <p style="font-size:12.5px; color:var(--ink-soft);">Para reuniones íntimas</p>
            <div class="cb-pkg-price">Q450<span> / hasta 15 personas</span></div>
            <div class="cb-pkg-list">
                <div>✓ Pastel personalizado a elección</div>
                <div>✓ Mesa de tartaletas variadas</div>
                <div>✓ Decoración temática básica</div>
            </div>
            <a asp-controller="Contacto" asp-action="Index" class="btn cb-btn-outline">Cotizar este paquete</a>
        </div>
        <div class="cb-pkg-card featured">
            <div class="cb-pkg-badge">Más popular</div>
            <h4>Bodas</h4>
            <p style="font-size:12.5px; color:var(--ink-soft);">Mesa dulce completa</p>
            <div class="cb-pkg-price">Q2,800<span> / hasta 80 personas</span></div>
            <div class="cb-pkg-list">
                <div>✓ Pastel de bodas de 3 pisos</div>
                <div>✓ Mesa dulce con 6 variedades</div>
                <div>✓ Degustación previa incluida</div>
                <div>✓ Decoración con flores comestibles</div>
            </div>
            <a asp-controller="Contacto" asp-action="Index" class="btn cb-btn-plum">Cotizar este paquete</a>
        </div>
        <div class="cb-pkg-card">
            <h4>Corporativo</h4>
            <p style="font-size:12.5px; color:var(--ink-soft);">Para tu empresa</p>
            <div class="cb-pkg-price">Q35<span> / persona</span></div>
            <div class="cb-pkg-list">
                <div>✓ Postres individuales para llevar</div>
                <div>✓ Opciones sin azúcar disponibles</div>
                <div>✓ Entrega puntual en oficina</div>
            </div>
            <a asp-controller="Contacto" asp-action="Index" class="btn cb-btn-outline">Cotizar este paquete</a>
        </div>
    </div>
</div>

<div class="cb-section tinted">
    <div class="cb-section-inner">
        <div class="cb-section-head"><span class="eyebrow">proceso simple</span><h2>Cómo funciona</h2></div>
        <div class="cb-steps-row">
            <div class="cb-step-item"><div class="cb-step-line"></div><div class="cb-step-num">1</div><h4>Cotización</h4><p>Cuéntanos sobre tu evento y te armamos una propuesta a medida.</p></div>
            <div class="cb-step-item"><div class="cb-step-line"></div><div class="cb-step-num">2</div><h4>Degustación</h4><p>Agenda una cita para probar y ajustar el menú antes del evento.</p></div>
            <div class="cb-step-item"><div class="cb-step-line"></div><div class="cb-step-num">3</div><h4>Confirmación</h4><p>Apartamos tu fecha con un anticipo y afinamos los últimos detalles.</p></div>
            <div class="cb-step-item"><div class="cb-step-num">4</div><h4>Entrega</h4><p>Llegamos puntuales y montamos la mesa dulce el día de tu evento.</p></div>
        </div>
    </div>
</div>

<div class="cb-section">
    <div class="cb-section-head"><span class="eyebrow">momentos que hemos endulzado</span><h2>Galería de eventos</h2></div>
    <div class="cb-gallery-grid">
        <div class="cb-gallery-item" style="background:linear-gradient(135deg,#F2D6C9,#E8B876);"></div>
        <div class="cb-gallery-item" style="background:linear-gradient(135deg,#E8C99B,#C9982E);"></div>
        <div class="cb-gallery-item" style="background:linear-gradient(135deg,#D9B48F,#7C2B3B);"></div>
        <div class="cb-gallery-item" style="background:linear-gradient(135deg,#F0C9A0,#A87A1E);"></div>
    </div>
</div>

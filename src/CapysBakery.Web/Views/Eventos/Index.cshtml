@using CapysBakery.Web.Models
@{
    ViewData["Title"] = "Eventos y Catering";
    var paquetes = ViewBag.Paquetes as List<PaqueteEvento> ?? new();
}

<div class="cb-catalog-hero" style="text-align:center;">
    <span class="eyebrow">celebraciones a tu medida</span>
    <h1>Eventos y Catering</h1>
    <p style="max-width:520px; margin:0 auto;">Desde cumpleaños íntimos hasta bodas y eventos corporativos — armamos el menú dulce perfecto para tu celebración.</p>
</div>

<div class="cb-section" style="padding-top:20px;">
    <div class="cb-pkg-row">
        @if (!paquetes.Any())
        {
            <p class="text-muted" style="text-align:center; width:100%;">Todavía no hay paquetes publicados.</p>
        }
        @foreach (var paquete in paquetes)
        {
            bool destacado = !string.IsNullOrWhiteSpace(paquete.Etiqueta);
            <div class="cb-pkg-card @(destacado ? "featured" : "")">
                @if (destacado)
                {
                    <div class="cb-pkg-badge">@paquete.Etiqueta</div>
                }
                <h4>@paquete.Nombre</h4>
                @if (!string.IsNullOrWhiteSpace(paquete.Subtitulo))
                {
                    <p style="font-size:12.5px; color:var(--ink-soft);">@paquete.Subtitulo</p>
                }
                <div class="cb-pkg-price">
                    Q@(paquete.Precio.ToString("0.##"))
                    @if (!string.IsNullOrWhiteSpace(paquete.UnidadPrecio))
                    {
                        <span> / @paquete.UnidadPrecio</span>
                    }
                </div>
                <div class="cb-pkg-list">
                    @foreach (var item in paquete.ItemsIncluidos)
                    {
                        <div>✓ @item</div>
                    }
                </div>
                <a asp-controller="Contacto" asp-action="Index" class="btn @(destacado ? "cb-btn-plum" : "cb-btn-outline")">Cotizar este paquete</a>
            </div>
        }
    </div>
</div>

<div class="cb-section tinted">
    <div class="cb-section-inner">
        <div class="cb-section-head"><span class="eyebrow">proceso simple</span><h2>Cómo funciona</h2></div>
        <div class="cb-steps-row">
            <div class="cb-step-item"><div class="cb-step-line"></div><div class="cb-step-num">1</div><h4>Cotización</h4><p>Cuéntanos sobre tu evento y te armamos una propuesta a medida.</p></div>
            <div class="cb-step-item"><div class="cb-step-line"></div><div class="cb-step-num">2</div><h4>Degustación</h4><p>Agenda una cita para probar y ajustar el menú antes del evento.</p></div>
            <div class="cb-step-item"><div class="cb-step-line"></div><div class="cb-step-num">3</div><h4>Confirmación</h4><p>Apartamos tu fecha con un anticipo y afinamos los últimos detalles.</p></div>
            <div class="cb-step-item"><div class="cb-step-num">4</div><h4>Entrega</h4><p>Llegamos puntuales y montamos la mesa dulce el día de tu evento.</p></div>
        </div>
    </div>
</div>

<div class="cb-section">
    <div class="cb-section-head"><span class="eyebrow">momentos que hemos endulzado</span><h2>Galería de eventos</h2></div>
    <div class="cb-gallery-grid">
        @{
            var fondosOriginales = new[]
            {
                "background:linear-gradient(135deg,#F2D6C9,#E8B876);",
                "background:linear-gradient(135deg,#E8C99B,#C9982E);",
                "background:linear-gradient(135deg,#D9B48F,#7C2B3B);",
                "background:linear-gradient(135deg,#F0C9A0,#A87A1E);",
            };
            var imagenesGaleria = ViewBag.ImagenesGaleria as string?[] ?? new string?[4];
        }
        @for (int i = 0; i < 4; i++)
        {
            var url = i < imagenesGaleria.Length ? imagenesGaleria[i] : null;
            if (!string.IsNullOrEmpty(url))
            {
                <div class="cb-gallery-item" style="background-image:url('@url'); background-size:cover; background-position:center;"></div>
            }
            else
            {
                <div class="cb-gallery-item" style="@fondosOriginales[i]"></div>
            }
        }
    </div>
</div>

@{
    ViewData["Title"] = "Tu carrito";
}

<div class="cb-catalog-hero">
    <h1 style="font-size:32px;">Tu carrito</h1>
    <p id="cb-cart-count-text">Cargando tu pedido...</p>
</div>

<div class="cb-cart-layout">
    <div class="cb-cart-items" id="cb-cart-items">
        <!-- El JS de carrito.js llena esto con lo que haya en localStorage -->
    </div>

    <div class="cb-cart-summary">
        <h4 style="margin-bottom:20px;">Resumen del pedido</h4>
        <div class="cb-summary-row"><span>Subtotal</span><span id="cb-subtotal">Q0.00</span></div>
        <div class="cb-summary-row"><span>Entrega a domicilio</span><span>Q35.00</span></div>
        <div class="cb-summary-row total"><span>Total estimado</span><span id="cb-total">Q35.00</span></div>

        <a asp-controller="Checkout" asp-action="DatosCliente" class="btn cb-btn-plum" style="text-align:center; margin-top:24px; padding:15px; display:block;">Continuar al formulario</a>
    </div>
</div>

<template id="cb-cart-item-template">
    <div class="cb-cart-item">
        <div class="cb-cart-thumb"></div>
        <div class="cb-cart-item-info">
            <div class="cb-cart-item-name"></div>
            <div class="cb-cart-item-opt"></div>
        </div>
        <div class="cb-qty-box small">
            <button type="button" class="cb-qty-minus">−</button>
            <span class="cb-qty-value">1</span>
            <button type="button" class="cb-qty-plus">+</button>
        </div>
        <div class="cb-cart-item-price"></div>
        <button type="button" class="cb-cart-item-remove" aria-label="Quitar">✕</button>
    </div>
</template>

<div id="cb-cart-empty" class="cb-cart-empty" style="display:none;">
    <p>Tu carrito está vacío.</p>
    <a asp-controller="Catalogo" asp-action="Index" class="btn cb-btn-plum">Ver el menú</a>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => CapysCarrito.renderizarPaginaCarrito());
    </script>
}

@{
    ViewData["Title"] = "Crear cuenta de equipo";
}

<div class="cb-catalog-hero">
    <h1 style="font-size:30px;">Crear cuenta de equipo</h1>
    <p>Define si la nueva cuenta tendrá acceso de Vendedor (día a día: productos, pedidos, blog) o de Dueño (acceso total).</p>
</div>

<div class="cb-admin-layout" style="max-width:520px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="cb-form-error">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form method="post" asp-controller="AdminUsuarios" asp-action="Crear">
        <div class="cb-cf-line">
            <label for="nombre">Nombre completo</label>
            <input type="text" id="nombre" name="nombre" class="cb-form-input" required />
        </div>
        <div class="cb-cf-line">
            <label for="correo">Correo electrónico</label>
            <input type="email" id="correo" name="correo" class="cb-form-input" required />
        </div>
        <div class="cb-cf-line">
            <label for="telefono">Teléfono <span class="opt">(opcional)</span></label>
            <input type="tel" id="telefono" name="telefono" class="cb-form-input" />
        </div>
        <div class="cb-cf-line">
            <label for="password">Contraseña temporal</label>
            <input type="password" id="password" name="password" class="cb-form-input" required />
        </div>
        <div class="cb-cf-line">
            <label for="rol">Tipo de acceso</label>
            <select id="rol" name="rol" class="cb-form-input">
                <option value="@CapysBakery.Web.Models.RolUsuario.Administrador">Vendedor (gestiona productos, pedidos y blog)</option>
                <option value="@CapysBakery.Web.Models.RolUsuario.Dueño">Dueño (acceso total, incluida esta pantalla)</option>
            </select>
        </div>
        <button type="submit" class="btn cb-btn-plum" style="width:100%;">Crear cuenta</button>
    </form>
</div>

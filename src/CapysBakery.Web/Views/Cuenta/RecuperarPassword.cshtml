@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="cb-auth-wrap">
    <div class="cb-auth-card">
        <div class="cb-auth-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l2.5 2.5"/></svg>
        </div>
        <h1>Recuperar contraseña</h1>
        <p class="cb-auth-sub">
            Confirma tu correo y el teléfono con el que te registraste, y podrás poner una contraseña nueva.
        </p>

        @if (ViewBag.Error is not null)
        {
            <div class="cb-form-error">@ViewBag.Error</div>
        }

        <form method="post" asp-controller="Cuenta" asp-action="RecuperarPassword">
            <div class="cb-cf-line">
                <label for="correo">Correo electrónico</label>
                <input type="email" id="correo" name="correo" class="cb-form-input" placeholder="tucorreo@ejemplo.com" required />
            </div>
            <div class="cb-cf-line">
                <label for="telefono">Teléfono registrado</label>
                <input type="tel" id="telefono" name="telefono" class="cb-form-input" placeholder="+502 0000 0000" required />
            </div>
            <div class="cb-cf-line">
                <label for="passwordNueva">Contraseña nueva</label>
                <input type="password" id="passwordNueva" name="passwordNueva" class="cb-form-input" placeholder="Crea una contraseña nueva" required />
            </div>
            <div class="cb-cf-line">
                <label for="confirmarPassword">Confirmar contraseña nueva</label>
                <input type="password" id="confirmarPassword" name="confirmarPassword" class="cb-form-input" placeholder="Repite la contraseña nueva" required />
            </div>
            <button type="submit" class="btn cb-btn-plum" style="width:100%;">Actualizar contraseña</button>
        </form>

        <p class="cb-auth-switch"><a asp-controller="Cuenta" asp-action="Login">← Volver a iniciar sesión</a></p>
    </div>
</div>

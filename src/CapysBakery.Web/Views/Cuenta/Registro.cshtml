@{
    ViewData["Title"] = "Crear cuenta";
    string? returnUrl = ViewBag.ReturnUrl;
}

<div class="cb-auth-wrap">
    <div class="cb-auth-card">
        <div class="cb-auth-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/><path d="M19 8h4M21 6v4"/></svg>
        </div>
        <h1>Crea tu cuenta</h1>
        <p class="cb-auth-sub">Regístrate para finalizar tu pedido y ver tu historial de compras.</p>

        <form method="post" asp-controller="Cuenta" asp-action="Registro" asp-route-returnUrl="@returnUrl">
            <div class="cb-cf-line">
                <label for="nombre">Nombre completo</label>
                <input type="text" id="nombre" name="nombre" class="cb-form-input" placeholder="Ej. María José Ramírez" required />
            </div>
            <div class="cb-cf-line">
                <label for="correo">Correo electrónico</label>
                <input type="email" id="correo" name="correo" class="cb-form-input" placeholder="tucorreo@ejemplo.com" required />
            </div>
            <div class="cb-cf-line">
                <label for="telefono">Teléfono</label>
                <input type="tel" id="telefono" name="telefono" class="cb-form-input" placeholder="+502 0000 0000" />
            </div>
            <div class="cb-cf-line">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" class="cb-form-input" placeholder="Crea una contraseña" required />
            </div>
            <button type="submit" class="btn cb-btn-plum" style="width:100%;">Crear cuenta</button>
        </form>

        <p class="cb-auth-switch">¿Ya tienes cuenta? <a asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@returnUrl">Iniciar sesión</a></p>
    </div>
</div>

@{
    ViewData["Title"] = "Iniciar sesión";
    string? returnUrl = ViewBag.ReturnUrl;
}

<div class="cb-auth-wrap">
    <div class="cb-auth-card">
        <div class="cb-auth-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        </div>
        <h1>Iniciar sesión</h1>
        <p class="cb-auth-sub">Accede a tu cuenta para continuar con tu pedido.</p>

        @if (ViewBag.Error is not null)
        {
            <div class="cb-form-error">@ViewBag.Error</div>
        }

        <form method="post" asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@returnUrl">
            <div class="cb-cf-line">
                <label for="correo">Correo electrónico</label>
                <input type="email" id="correo" name="correo" class="cb-form-input" placeholder="tucorreo@ejemplo.com" required />
            </div>
            <div class="cb-cf-line">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" class="cb-form-input" placeholder="Ingresa tu contraseña" required />
            </div>
            <button type="submit" class="btn cb-btn-plum" style="width:100%;">Ingresar</button>
        </form>

        <p class="cb-auth-switch">¿Aún no tienes cuenta? <a asp-controller="Cuenta" asp-action="Registro" asp-route-returnUrl="@returnUrl">Crear cuenta</a></p>
    </div>
</div>

@model List<Pedido>
@{
    ViewData["Title"] = "Mis pedidos";
}

<div class="cb-catalog-hero">
    <h1 style="font-size:30px;">Mis pedidos</h1>
    <p>Consulta el estado de tus pedidos anteriores, @User.Identity!.Name.</p>
</div>

<div class="cb-admin-layout" style="max-width:700px;">
    @if (Model.Count == 0)
    {
        <div class="cb-cart-empty">
            <p>Todavía no tienes pedidos registrados.</p>
            <a asp-controller="Catalogo" asp-action="Index" class="btn cb-btn-plum">Ir al catálogo</a>
        </div>
    }
    else
    {
        @foreach (var pedido in Model)
        {
            var productos = string.Join(", ", pedido.Detalles.Select(d => $"{d.Cantidad}× {d.Presentacion?.Producto?.Nombre ?? "(producto eliminado)"}"));

            // Datos mínimos para que "Pedir de nuevo" pueda reconstruir el
            // carrito (mismo formato que ya usa CapysCarrito.agregarProducto).
            var itemsParaJs = pedido.Detalles
                .Where(d => d.Presentacion?.Producto is not null)
                .Select(d => new
                {
                    id = d.Presentacion!.ProductoId,
                    presentacionId = d.PresentacionId,
                    nombre = $"{d.Presentacion.Producto!.Nombre} - {d.Presentacion.Nombre}",
                    precio = d.PrecioUnitario,
                    cantidad = d.Cantidad,
                });

            <div class="cb-pedido-card">
                <div class="cb-pedido-card-top">
                    <span class="cb-admin-pedido-id">#@pedido.CodigoPedido</span>
                    <span class="cb-estado-pill cb-estado-@(pedido.EstadoPedido?.Nombre.Replace(" ", "-"))">@pedido.EstadoPedido?.Nombre</span>
                </div>
                <p class="cb-admin-sub">@productos</p>
                <div class="cb-summary-row"><span>@pedido.ModalidadEntrega?.Nombre</span><span>@pedido.MetodoPago?.Nombre</span></div>
                <div class="cb-summary-row total"><span>Total</span><span>Q@(pedido.Total.ToString("0.00"))</span></div>

                @if (pedido.EstadoPedido?.Nombre == EstadosPedido.Entregado)
                {
                    @if (pedido.Calificacion is not null)
                    {
                        <div class="cb-admin-sub" style="margin-top:10px;">
                            Tu calificación:
                            <span style="color:#C9982E; letter-spacing:2px;">@(new string('★', pedido.Calificacion.Estrellas))@(new string('☆', 5 - pedido.Calificacion.Estrellas))</span>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Cuenta" asp-action="Calificar" method="post" style="margin-top:12px; border-top:1px solid #EEE1CC; padding-top:12px;">
                            <input type="hidden" name="pedidoId" value="@pedido.Id" />
                            <label class="cb-admin-sub" style="display:block; margin-bottom:6px;">¿Cómo calificarías este pedido?</label>
                            <div class="cb-estrellas-input">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" id="estrella-@(pedido.Id)-@i" name="estrellas" value="@i" required />
                                    <label for="estrella-@(pedido.Id)-@i">★</label>
                                }
                            </div>
                            <input type="text" name="comentario" class="cb-form-input" placeholder="Comentario (opcional)" style="margin-top:8px;" />
                            <button type="submit" class="btn cb-btn-outline" style="margin-top:8px; width:100%;">Enviar calificación</button>
                        </form>
                    }
                }

                <button type="button" class="btn cb-btn-outline cb-pedir-de-nuevo" style="width:100%; margin-top:12px;"
                        data-items="@Html.Raw(System.Net.WebUtility.HtmlEncode(System.Text.Json.JsonSerializer.Serialize(itemsParaJs)))">
                    ↻ Pedir de nuevo
                </button>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/mis-pedidos.js" asp-append-version="true"></script>
}

<style>
    .cb-estrellas-input {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 2px;
    }
    .cb-estrellas-input input[type="radio"] {
        display: none;
    }
    .cb-estrellas-input label {
        font-size: 24px;
        color: #E0D3C0;
        cursor: pointer;
    }
    .cb-estrellas-input input[type="radio"]:checked ~ label,
    .cb-estrellas-input label:hover,
    .cb-estrellas-input label:hover ~ label {
        color: #C9982E;
    }
</style>

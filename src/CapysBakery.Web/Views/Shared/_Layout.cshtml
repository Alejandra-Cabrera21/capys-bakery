@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Capys Bakery</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=Work+Sans:wght@400;500;600;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header class="cb-nav">
        <div class="cb-nav-inner">
            <a class="cb-logo" asp-controller="Home" asp-action="Index">
                <span class="cb-logo-mark">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6"><path d="M4 12c2-6 14-6 16 0M4 12c1 5 4 8 8 8s7-3 8-8M4 12h16"/></svg>
                </span>
                <span class="cb-logo-text">Capys Bakery</span>
            </a>

            <nav class="cb-nav-links" id="cb-mobile-menu">
                <a asp-controller="Home" asp-action="Index" class="@(currentAction == "Index" && currentController == "Home" ? "active" : "")">Inicio</a>
                <a asp-controller="Catalogo" asp-action="Index" class="@(currentController == "Catalogo" ? "active" : "")">Menú</a>
                <a asp-controller="Nosotros" asp-action="Index" class="@(currentController == "Nosotros" ? "active" : "")">Nosotros</a>
                <a asp-controller="Eventos" asp-action="Index" class="@(currentController == "Eventos" ? "active" : "")">Eventos</a>
                <a asp-controller="Blog" asp-action="Index" class="@(currentController == "Blog" ? "active" : "")">Blog</a>
                <a asp-controller="Contacto" asp-action="Index" class="@(currentController == "Contacto" ? "active" : "")">Contacto</a>
                @if (!(User.Identity?.IsAuthenticated ?? false))
                {
                    <a asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                }
            </nav>

            <div class="cb-nav-cta">
                <a asp-controller="Carrito" asp-action="Index" class="cb-icon-badge">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#3A2419" stroke-width="1.8"><circle cx="9" cy="21" r="1.4"/><circle cx="18" cy="21" r="1.4"/><path d="M2 3h3l2.4 12.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.6L22 7H6"/></svg>
                    <span class="cb-badge-num" data-cart-badge>0</span>
                </a>
                <a asp-controller="Catalogo" asp-action="Index" class="btn cb-btn-plum cb-desktop-only">Pedir ahora</a>
                @if (!(User.Identity?.IsAuthenticated ?? false))
                {
                    <a asp-controller="Cuenta" asp-action="Login" class="btn cb-btn-outline cb-desktop-only">Iniciar sesión</a>
                }
                <button type="button" class="cb-hamburger" id="cb-hamburger-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="cb-mobile-menu">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3A2419" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="cb-footer">
        <div class="cb-footer-grid">
            <div class="cb-footer-col">
                <div class="cb-logo" style="margin-bottom:14px;">
                    <span class="cb-logo-mark"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6"><path d="M4 12c2-6 14-6 16 0M4 12c1 5 4 8 8 8s7-3 8-8M4 12h16"/></svg></span>
                    <span class="cb-logo-text" style="font-size:18px;">Capys Bakery</span>
                </div>
                <p>Repostería artesanal hecha con ingredientes reales, en pequeños lotes, desde Guatemala.</p>
                <div class="cb-social-row">
                    <span class="cb-social-dot">IG</span><span class="cb-social-dot">FB</span><span class="cb-social-dot">TT</span>
                </div>
            </div>
            <div class="cb-footer-col">
                <h5>Explorar</h5>
                <div>Menú completo</div>
                <div>Eventos y catering</div>
                <div>Blog y recetas</div>
                <div>Nuestra historia</div>
            </div>
            <div class="cb-footer-col">
                <h5>Ayuda</h5>
                <div>Cómo pedir</div>
                <div>Zonas de entrega</div>
                <div>Preguntas frecuentes</div>
                <div>Contacto</div>
            </div>
            <div class="cb-footer-col">
                <h5>Contacto</h5>
                <div>+502 5555 1234</div>
                <div>hola@capysbakery.com</div>
                <div>Zona 14, Ciudad de Guatemala</div>
            </div>
        </div>
        <div class="cb-footer-bottom">
            <span>&copy; @DateTime.Now.Year Capys Bakery. Todos los derechos reservados.</span>
            <span>Hecho con ♥ y mucha harina.</span>
        </div>
    </footer>

    <nav class="cb-bottom-nav">
        <a asp-controller="Home" asp-action="Index" class="cb-bn-item @(currentAction == "Index" && currentController == "Home" ? "active" : "")">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5 12 4l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z"/></svg>
            <span>Inicio</span>
        </a>
        <a asp-controller="Catalogo" asp-action="Index" class="cb-bn-item @(currentController == "Catalogo" ? "active" : "")">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7l9-4 9 4-9 4-9-4Zm0 0v10l9 4m0-14v14m9-14v10l-9 4"/></svg>
            <span>Menú</span>
        </a>
        <a asp-controller="Carrito" asp-action="Index" class="cb-bn-item @(currentController == "Carrito" ? "active" : "")">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1.4"/><circle cx="18" cy="21" r="1.4"/><path d="M2 3h3l2.4 12.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.6L22 7H6"/></svg>
            <span>Carrito</span>
            <span class="cb-bn-badge" data-cart-badge>0</span>
        </a>
        <a asp-controller="Contacto" asp-action="Index" class="cb-bn-item @(currentController == "Contacto" ? "active" : "")">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
            <span>Contacto</span>
        </a>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/carrito.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

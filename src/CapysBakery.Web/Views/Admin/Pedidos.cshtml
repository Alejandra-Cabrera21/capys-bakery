@{
    ViewData["Title"] = "Gestión de pedidos";
}

<div class="cb-catalog-hero">
    <h1 style="font-size:30px;">Gestión de pedidos</h1>
    <p>Consulta los pedidos recibidos, revisa el detalle y actualiza su estado.</p>
</div>

<div class="cb-admin-banner">
    ⚠️ <b>Modo de prueba:</b> mientras no exista base de datos, aquí solo se ven los pedidos generados desde <b>este mismo navegador</b> (quedan guardados en <code>localStorage</code>). Los pedidos reales de clientes en otros dispositivos requieren la base de datos conectada.
</div>

<div class="cb-admin-layout">
    <table class="cb-admin-table" id="cb-tabla-pedidos">
        <thead>
            <tr>
                <th>Pedido</th>
                <th>Cliente</th>
                <th>Productos</th>
                <th>Entrega</th>
                <th>Pago</th>
                <th>Total</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody id="cb-pedidos-tbody">
            <!-- llenado por admin-pedidos.js desde localStorage -->
        </tbody>
    </table>

    <div id="cb-sin-pedidos" class="cb-cart-empty" style="display:none;">
        <p>Todavía no hay pedidos registrados en este navegador.</p>
        <a asp-controller="Catalogo" asp-action="Index" class="btn cb-btn-plum">Ir al catálogo</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-pedidos.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => CapysAdminPedidos.renderizar());
    </script>
}

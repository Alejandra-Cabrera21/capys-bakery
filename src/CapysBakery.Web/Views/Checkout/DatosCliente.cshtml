@{
    ViewData["Title"] = "Tus datos de entrega";
}

<div class="cb-catalog-hero">
    <h1 style="font-size:32px;">Tus datos de entrega</h1>
    <p>Solo un paso más antes de confirmar tu pedido por WhatsApp.</p>
</div>

<div class="cb-cf-layout">
    <form id="form-datos-cliente" class="cb-cf-form-col">
        <div class="cb-cf-line">
            <label for="nombre">Nombre completo</label>
            <input type="text" id="nombre" name="nombre" class="cb-form-input" placeholder="Ej. María José Ramírez" value="@ViewBag.NombreUsuario" required />
        </div>
        <div class="cb-cf-line">
            <label for="telefono">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" class="cb-form-input" placeholder="+502 0000 0000" required />
        </div>

        <div class="cb-cf-line">
            <label>Forma de entrega</label>
            <div class="cb-toggle-row" data-config="entrega">
                @{
                    var modalidades = ViewBag.ModalidadesEntrega as List<CapysBakery.Web.Models.ModalidadEntrega> ?? new();
                }
                @for (var i = 0; i < modalidades.Count; i++)
                {
                    var modalidad = modalidades[i];
                    var icono = modalidad.Nombre == "Envío" ? "📦" : "🏠";
                    <button type="button" class="cb-toggle @(i == 0 ? "active" : "")" data-valor="@modalidad.Nombre" data-requiere-direccion="@modalidad.RequiereDireccion.ToString().ToLower()">@icono @modalidad.Nombre</button>
                }
            </div>
        </div>

        <div class="cb-cf-line">
            <label for="direccion">Dirección de entrega</label>
            <input type="text" id="direccion" name="direccion" class="cb-form-input" placeholder="Ej. Zona 14, Ciudad de Guatemala" />
        </div>

        <div class="cb-cf-line">
            <label>Modalidad de pago</label>
            <div class="cb-toggle-row" data-config="pago" id="cb-opciones-pago">
                @{
                    var metodosPago = ViewBag.MetodosPago as List<CapysBakery.Web.Models.MetodoPago> ?? new();
                }
                @for (var i = 0; i < metodosPago.Count; i++)
                {
                    var metodo = metodosPago[i];
                    var icono = metodo.SoloRecoger ? "💵" : "🏦";
                    var para = metodo.SoloRecoger ? "recoger" : "envio,recoger";
                    <button type="button" class="cb-toggle @(i == 0 ? "active" : "")" data-valor="@metodo.Nombre" data-para="@para">@icono @metodo.Nombre</button>
                }
            </div>
            <p class="cb-hint-text">"Pago al recoger" (efectivo o transferencia en el momento) solo está disponible si eliges Recoger. Para Envío, únicamente Transferencia bancaria.</p>

            <div id="cb-datos-bancarios" style="display:block; margin-top:14px; background:var(--cream-2); border-radius:10px; padding:14px 16px;">
                <p style="font-size:11.5px; font-weight:700; color:var(--ink); margin-bottom:8px;">Datos para transferencia:</p>
                @{
                    var cuenta = ViewBag.CuentaBancaria as CapysBakery.Web.Models.CuentaBancaria;
                }
                @if (cuenta is not null)
                {
                    <div class="cb-summary-row"><span>Banco</span><span>@cuenta.Banco</span></div>
                    <div class="cb-summary-row"><span>Tipo de cuenta</span><span>@cuenta.TipoCuenta</span></div>
                    <div class="cb-summary-row"><span>Número de cuenta</span><span>@cuenta.NumeroCuenta</span></div>
                    <div class="cb-summary-row"><span>Titular</span><span>@cuenta.Titular</span></div>
                }
                <p class="cb-hint-text" style="margin-top:10px; margin-bottom:0;">📲 Después de hacer la transferencia, envía tu comprobante de pago por WhatsApp para confirmar tu pedido.</p>
            </div>
        </div>

        <div class="cb-cf-line">
            <label for="fecha">Fecha de entrega</label>
            <input type="date" id="fecha" name="fecha" class="cb-form-input" required />
        </div>

        <div class="cb-cf-line">
            <label for="notas">Comentarios adicionales <span class="opt">(opcional)</span></label>
            <textarea id="notas" name="notas" class="cb-form-input cb-textarea" placeholder='Ej. "Mensaje en el pastel: Feliz cumpleaños Ana", decoración, alergias, etc.'></textarea>
        </div>
    </form>

    <div class="cb-cf-summary-col">
        <div class="cb-cf-summary-card">
            <h4 style="margin-bottom:18px;">Resumen del pedido</h4>
            <div id="cb-checkout-items"><!-- llenado por checkout.js desde localStorage --></div>
            <div class="cb-summary-row"><span>Envío (si aplica)</span><span>Q35.00</span></div>
            <div class="cb-summary-row total"><span>Total estimado</span><span id="cb-checkout-total">Q0.00</span></div>

            <div class="cb-wa-note">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E9E4F" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg>
                <p><b>Confirmación por WhatsApp</b>El total es estimado. Tu pedido queda registrado como "Pendiente" y se confirma disponibilidad, entrega y pago con nuestro equipo por WhatsApp.</p>
            </div>

            <button type="submit" form="form-datos-cliente" class="btn cb-btn-plum" id="btn-continuar-whatsapp" style="width:100%; display:flex; align-items:center; justify-content:center; gap:8px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg>
                Enviar pedido por WhatsApp
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Correo de la cuenta con sesión iniciada. checkout.js lo guarda
        // dentro del pedido para que "Mis pedidos" (Cuenta/MisPedidos) pueda
        // filtrar solo los pedidos de este comprador. [Authorize] en
        // CheckoutController garantiza que siempre hay sesión al llegar aquí.
        window.CAPYS_USUARIO_CORREO = @Html.Raw(Json.Serialize(ViewBag.CorreoUsuario));
    </script>
    <script src="~/js/checkout.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => CapysCheckout.iniciarFormularioDatosCliente());
    </script>
}

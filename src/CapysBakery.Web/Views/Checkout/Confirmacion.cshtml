@{
    ViewData["Title"] = "Pedido registrado";
    Layout = "_Layout";
}

<div class="cb-cc-wrap">
    <div class="cb-cc-check">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <div class="cb-cc-status-pill">Pendiente de confirmación</div>
    <h1>¡Pedido registrado!</h1>
    <div class="cb-cc-order" id="cb-numero-pedido">Pedido #—</div>
    <p class="cb-cc-sub">Te hemos redirigido a WhatsApp con el resumen de tu pedido. Nuestro equipo confirmará disponibilidad, costo final de envío y método de pago contigo directamente.</p>

    <div class="cb-cc-summary-card" id="cb-cc-items">
        <!-- llenado por checkout.js a partir de lo que quedó guardado -->
    </div>

    <div class="cb-cc-btns">
        <a asp-controller="Home" asp-action="Index" class="btn cb-btn-outline">Volver al inicio</a>
        <button type="button" id="btn-reabrir-whatsapp" class="btn cb-btn-plum" style="display:flex; align-items:center; gap:8px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg>
            Abrir WhatsApp de nuevo
        </button>
    </div>

    <div class="cb-cc-steps">
        <h5>¿Qué sigue ahora?</h5>
        <div class="cb-cc-step"><div class="num">1</div>Nuestro equipo confirma tu pedido por WhatsApp, normalmente en menos de 2 horas.</div>
        <div class="cb-cc-step"><div class="num">2</div>Coordinamos el método de pago y el costo final de envío según tu zona.</div>
        <div class="cb-cc-step"><div class="num">3</div>Preparamos tu pedido y te avisamos cuando esté en camino o listo para recoger.</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/checkout.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => CapysCheckout.renderizarConfirmacion());
    </script>
}
